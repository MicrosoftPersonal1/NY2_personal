// Aggregation tests generated from tests/catalog.yml
// Paste into DAX query view (one result per EVALUATE) or let Copilot run them (/run-tests).

// [value must not be blank] Umsatz: model has data
EVALUATE ROW ( "Value", [Umsatz] )

// [0 rows = PASS] Umsatz: Store[StoreKey] -> Store[State]
EVALUATE
VAR t = SUMMARIZECOLUMNS ( Store[State], "Parent", [Umsatz],
    "SumChildren", SUMX ( VALUES ( Store[StoreKey] ), [Umsatz] ) )
RETURN FILTER ( ADDCOLUMNS ( t, "Diff", [Parent] - [SumChildren] ), ABS ( [Diff] ) > 0.01 )

// [0 rows = PASS] Umsatz: Store[State] -> Store[Country]
EVALUATE
VAR t = SUMMARIZECOLUMNS ( Store[Country], "Parent", [Umsatz],
    "SumChildren", SUMX ( VALUES ( Store[State] ), [Umsatz] ) )
RETURN FILTER ( ADDCOLUMNS ( t, "Diff", [Parent] - [SumChildren] ), ABS ( [Diff] ) > 0.01 )

