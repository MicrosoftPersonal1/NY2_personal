// [0 rows = PASS] Marge %: ratio at Store[StoreKey]
EVALUATE
VAR t = SUMMARIZECOLUMNS ( Store[StoreKey], "Value", [Marge %], "Expected", DIVIDE ( [Marge], [Umsatz] ) )
RETURN FILTER ( ADDCOLUMNS ( t, "Diff", [Value] - [Expected] ), ABS ( [Diff] ) > 0.0001 )

