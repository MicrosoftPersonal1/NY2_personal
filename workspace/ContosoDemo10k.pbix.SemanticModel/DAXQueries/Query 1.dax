// [0 rows = PASS] Umsatz: 'Date'[Month] -> 'Date'[Year]
EVALUATE
VAR t = SUMMARIZECOLUMNS ( 'Date'[Year], "Parent", [Umsatz],
    "SumChildren", SUMX ( VALUES ( 'Date'[Month] ), [Umsatz] ) )
RETURN FILTER ( ADDCOLUMNS ( t, "Diff", [Parent] - [SumChildren] ), ABS ( [Diff] ) > 0.01 )

// [0 rows = PASS] Umsatz: Store[Country] -> total
EVALUATE
VAR tot = CALCULATE ( [Umsatz], REMOVEFILTERS () )
VAR parts = SUMX ( ALLNOBLANKROW ( Store[Country] ), [Umsatz] )
RETURN FILTER ( ROW ( "Total", tot, "SumParts", parts, "Diff", tot - parts ), ABS ( [Diff] ) > 0.01 )

