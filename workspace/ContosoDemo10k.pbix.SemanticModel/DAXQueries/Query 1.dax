// [0 rows = PASS] Kunden (eindeutig): distinct Store[StoreKey] -> Store[Country]
EVALUATE
VAR t = SUMMARIZECOLUMNS ( Store[Country], "Value", [Kunden (eindeutig)],
    "MaxChild", MAXX ( VALUES ( Store[StoreKey] ), [Kunden (eindeutig)] ), "SumChildren", SUMX ( VALUES ( Store[StoreKey] ), [Kunden (eindeutig)] ) )
RETURN FILTER ( t, [Value] < [MaxChild] || [Value] > [SumChildren] )

// [0 rows = PASS] Kunden (eindeutig): distinct 'Date'[Month] -> 'Date'[Year]
EVALUATE
VAR t = SUMMARIZECOLUMNS ( 'Date'[Year], "Value", [Kunden (eindeutig)],
    "MaxChild", MAXX ( VALUES ( 'Date'[Month] ), [Kunden (eindeutig)] ), "SumChildren", SUMX ( VALUES ( 'Date'[Month] ), [Kunden (eindeutig)] ) )
RETURN FILTER ( t, [Value] < [MaxChild] || [Value] > [SumChildren] )

// [compare with tests/reference/umsatz_land_jahr.csv] Umsatz: vs reference
EVALUATE SUMMARIZECOLUMNS ( Store[Country], 'Date'[Year], "Value", [Umsatz] )
