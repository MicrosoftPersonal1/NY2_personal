model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Customer","Date","Product","Sales","Store","DatabaseName"]

annotation PBI_ProTooling = ["TMDLView_Desktop","DevMode","MCP-PBIModeling","CopilotTooling"]

ref table Customer
ref table Date
ref table Product
ref table Sales
ref table Store

ref cultureInfo en-US

